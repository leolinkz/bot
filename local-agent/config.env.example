# Copy to config.env and edit. `run.sh` sources it.

# --- Local LLM (any OpenAI-compatible endpoint) ---
# Ollama:     http://localhost:11434/v1     model e.g. llama3.1:8b , qwen2.5:14b
# LM Studio:  http://localhost:1234/v1      model = whatever you loaded
# llama.cpp:  http://localhost:8080/v1      (server --api)
# vLLM:       http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=local
LLM_TEMPERATURE=0.2

# --- Market data (Deriv public WebSocket, no account needed) ---
DERIV_APP_ID=1089
SYMBOL=R_75
MIN_RR=1.5

# --- Test toggles (leave unset in normal use) ---
# LLM_MOCK=1       # skip the model, synthesize an idea from the data (pipeline test)
# DERIV_SAMPLE=1   # use sample_candles.json instead of the live feed (offline test)
